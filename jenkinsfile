
pipeline {
    agent any

    environment {
        NETLIFY_SITE_ID = '7e65f2c0-a93c-489a-9920-4fcd79b4b6c1'
    }

    stages {

        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    node --version
                    npm ci
                    npm run build
                '''
            }
        }

   stage('Test') {
    agent {
        docker {
            image 'node:18-alpine'
            reuseNode true
        }
    }
    steps {
        sh '''
            npm test
        '''
    }
}

        stage('Deploy') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                    args '-u root'
                }
            }
            steps {
                withCredentials([
                    string(
                        credentialsId: 'netlify-auth-token',
                        variable: 'NETLIFY_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        npm install -g netlify-cli
                        netlify --version

                        netlify deploy \
                            --prod \
                            --dir=build \
                            --site="$NETLIFY_SITE_ID" \
                            --auth="$NETLIFY_AUTH_TOKEN"
                    '''
                }
            }
        }
    }
}
