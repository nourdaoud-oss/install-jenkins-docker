
pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    node --version
                    npm ci
                    npm run build
                '''
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npm test
                '''
            }
        }

        
     stage('Deploy') {
        agent {
         docker {
            image 'node:18-alpine'
            reuseNode true
            args '-u root'
        }
    }
        steps {
           sh '''
            npm install -g netlify-cli
            netlify --version
        '''
    }
}
  
    }
}
